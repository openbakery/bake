#!/bin/bash

WORKING_DIRECTORY=./build/bake
BAKE_BOOTSTRAP_DIRECTORY=$WORKING_DIRECTORY/cli
BAKE_BOOTSTRAP_CLI=$BAKE_BOOTSTRAP_DIRECTORY/BakeCLI
BAKE_CLI=$WORKING_DIRECTORY/bootstrap/bake
BRANCH=main
QUIET=--quiet
DEBUG=false

run_silent() {
	if [ "$DEBUG" = true ]; then
		"$@"
		return $?
	fi

    local output
    output=$("$@" 2>&1)
    local status=$?

    if [ $status -ne 0 ]; then
        echo "Command failed: $*"
        echo "$output"
        return $status
    fi
    return 0
}

progress() {
	if [ "$DEBUG" = true ]; then
		echo $1
		return
	fi
	stop_spinner
  start_spinner "$1" &
  SPINNER_PID=$!
}

start_spinner() {
	if [ "$DEBUG" = true ]; then
		return
	fi
	local text="$1"
	local spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
	local i=0

	while true; do
		i=$(( (i+1) % 10 ))
		printf "\r${spin:$i:1} $text "
		sleep 0.1
	done
}

stop_spinner() {
    kill $SPINNER_PID 2>/dev/null
    wait $SPINNER_PID 2>/dev/null
    printf "\r\033[K"  # Clear the spinner line
}


bootstrap() {
	trap stop_spinner EXIT
	start_spinner "Initializing build..." &
	SPINNER_PID=$!

	progress "Bootstrap"
	if [ -d "$WORKING_DIRECTORY" ]; then
		rm -rf "$WORKING_DIRECTORY"
	fi

	mkdir -p $BAKE_BOOTSTRAP_DIRECTORY
	SOURCE_DIRECTORY=$BAKE_BOOTSTRAP_DIRECTORY/checkout
	progress "Bootstrap - Clone Bake"
	git clone $QUIET -b $BRANCH https://github.com/openbakery/bake.git $SOURCE_DIRECTORY

	progress "Bootstrap - Build base project"
	run_silent swift build $QUIET -c release --package-path $SOURCE_DIRECTORY

	mv $SOURCE_DIRECTORY/.build/arm64-apple-macosx/release/BakeCLI $BAKE_BOOTSTRAP_CLI

	progress "Bootstrap - Build using project configuration bake.swift"

	run_silent $BAKE_BOOTSTRAP_CLI bootstrap

	stop_spinner
}

parameters=()


# Parse command line arguments
while [[ $# -gt 0 ]]; do
	case $1 in
		--debug|-d)
			DEBUG=true
			QUIET=""
			shift
			;;
		--refresh|-r)
			rm -rf "$WORKING_DIRECTORY"
			shift
			;;
		--help|-h)
			echo "Usage: $0 [OPTIONS]"
			echo "Options:"
			echo "  --debug, -d      Enable debug mode"
			echo "  --refresh, -r    Force run bootstrap"
			exit 0
			;;
		*)
			parameters+=("$1")
			shift
			;;
	esac
done



if [ ! -f "$BAKE_CLI" ]; then
	bootstrap
elif [ ! -f "$BAKE_BOOTSTRAP_CLI" ]; then
	bootstrap
fi


$BAKE_CLI "${parameters[@]}"


